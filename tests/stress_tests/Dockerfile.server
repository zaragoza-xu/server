FROM ubuntu:22.04 AS builder
RUN apt-get update && apt-get install -y cmake g++ ninja-build git && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
RUN cmake --preset release && cmake --build --preset release

FROM ubuntu:22.04
RUN apt-get update && apt-get install -y libstdc++6 iproute2 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /src/build/server /app/server
COPY config/server.json /app/config/server.json
EXPOSE 8765 8766 8767 8768 8769
CMD ["/app/server", "--config", "/app/config/server.json"]
