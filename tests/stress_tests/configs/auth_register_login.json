{
  "name": "auth_register_login",
  "description": "Short-connection baseline for auth port.",
  "target": {
    "host": "127.0.0.1",
    "port": 8765
  },
  "mode": "short_connection",
  "duration_seconds": 180,
  "concurrency": 100,
  "mix": [
    {
      "operation": "REGISTER",
      "weight": 30,
      "request_template": {
        "type": 1,
        "uid": ""
      }
    },
    {
      "operation": "LOGIN",
      "weight": 70,
      "request_template": {
        "type": 0,
        "uid_from_pool": true
      }
    }
  ],
  "metrics": {
    "latency_quantiles": [
      0.5,
      0.95,
      0.99
    ],
    "track_connect_latency": true,
    "track_error_codes": true
  },
  "thresholds": {
    "max_unexpected_error_rate": 0.001,
    "max_p99_latency_ms": 200.0,
    "max_connect_failures": 0
  },
  "threads": 4
}
