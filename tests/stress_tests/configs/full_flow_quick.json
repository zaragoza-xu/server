{
  "name": "full_flow",
  "description": "Quick smoke: auth through battle flow.",
  "targets": {
    "auth": { "host": "127.0.0.1", "port": 8765 },
    "lobby": { "host": "127.0.0.1", "port": 8766 },
    "map": { "host": "127.0.0.1", "port": 8768 },
